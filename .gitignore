# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright/
/artifacts/

# next.js
/.next/
/out/

# production
/build
/tmp/
/*.zip
/*.tar
/*.tar.gz

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data and private exports (Drizzle migrations under database/ stay tracked)
/*.sql
*.sqlite
*.sqlite3

# local planning/reference files that are not application inputs
/gemini-suggestions-plan.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
